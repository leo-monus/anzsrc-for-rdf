  <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/4517">
    <skos:prefLabel xml:lang="en">Pacific Peoples sciences</skos:prefLabel>
    <skos:notation xml:lang="en">4517</skos:notation>
    <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
    <skos:broader rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020/45"/>
    <skos:definition xml:lang="en">This group covers human society, economics, commerce, tourism, community governance and decision making, anthropology, human geography, community-based research, architecture and design, and urban planning related to Pacific Peoples.</skos:definition>
    <skos:scopeNote xml:lang="en">a) Pacific Peoples health policy is included in Group 4516 Pacific Peoples health and wellbeing.</skos:scopeNote>
