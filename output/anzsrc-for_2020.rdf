  <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/510501">
    <skos:prefLabel xml:lang="en">Biological physics</skos:prefLabel>
    <skos:notation xml:lang="en">510501</skos:notation>
    <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
    <skos:broader>
      <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/5105">
        <skos:prefLabel xml:lang="en">Medical and biological physics</skos:prefLabel>
        <skos:notation xml:lang="en">5105</skos:notation>
        <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
        <skos:broader rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020/51"/>
        <skos:definition xml:lang="en">This group covers medical and biological physics.</skos:definition>
        <skos:scopeNote xml:lang="en">a) Human biophysics is included in Group 3208 Medical physiology.</skos:scopeNote>
        <skos:narrower rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020/510501"/>
        <skos:narrower rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020/510502"/>
