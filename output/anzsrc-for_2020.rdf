  <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/310307">
    <skos:prefLabel xml:lang="en">Population ecology</skos:prefLabel>
    <skos:notation xml:lang="en">310307</skos:notation>
    <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
    <skos:broader>
      <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/3103">
        <skos:prefLabel xml:lang="en">Ecology</skos:prefLabel>
        <skos:notation xml:lang="en">3103</skos:notation>
        <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
        <skos:broader rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020/31"/>
        <skos:definition xml:lang="en">This group covers ecology other than its environmental applications.</skos:definition>
        <skos:scopeNote xml:lang="en">a) Palaeontology other than that associated with palaeoecological studies is included in Group 3705 Geology.
b) Applications of ecology, including the ecology of invasive species, are included in Group 4102 Ecological applications.
c) Population and ecological genetics is included in Group 3105 Genetics.
d) Microbial ecology is included in Group 3107 Microbiology.
e) Freshwater ichthyology and animal physiological ecology are included in Group 3109 Zoology.</skos:scopeNote>
