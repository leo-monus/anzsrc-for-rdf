  <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/450501">
    <skos:prefLabel xml:lang="en">Aboriginal and Torres Strait Islander accounting</skos:prefLabel>
    <skos:notation xml:lang="en">450501</skos:notation>
    <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
