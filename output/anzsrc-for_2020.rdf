  <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/460501">
    <skos:prefLabel xml:lang="en">Data engineering and data science</skos:prefLabel>
    <skos:notation xml:lang="en">460501</skos:notation>
    <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
    <skos:broader>
      <skos:Concept rdf:about="https://linked.data.gov.au/def/anzsrc-for/2020/4605">
        <skos:prefLabel xml:lang="en">Data management and data science</skos:prefLabel>
        <skos:notation xml:lang="en">4605</skos:notation>
        <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
        <skos:broader rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020/46"/>
        <skos:definition xml:lang="en">This group covers methods and computing systems for working with data sets.</skos:definition>
        <skos:scopeNote xml:lang="en">a) Mathematical transformations and techniques used in the querying of audio, images, or video are included in Group 4603 Computer vision and multimedia computation.
b) The management of or administration strategies for database systems are included in Group 4609 Information systems.
c) Cryptography, privacy, or security aspects of database systems are included in Group 4604 Cybersecurity and privacy.
d) The graphical visualization or visual presentations of data is included in Group 4608 Human-centred computing.
e) Machine learning techniques for analysis of large data sets is included in Group 4611 Machine learning.</skos:scopeNote>
