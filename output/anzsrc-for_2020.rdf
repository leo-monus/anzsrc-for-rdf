        <dcterms:title xml:lang="en">1297.0 ANZSRC - Australian and New Zealand Standard Research Classification, 2020: Fields of Research (FoR)</dcterms:title>
        <rdfs:label xml:lang="en">1297.0 ANZSRC - Australian and New Zealand Standard Research Classification, 2020: Fields of Research (FoR)</rdfs:label>
        <skos:prefLabel xml:lang="en">1297.0 ANZSRC - Australian and New Zealand Standard Research Classification, 2020: Fields of Research (FoR)</skos:prefLabel>
