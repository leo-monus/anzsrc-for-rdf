        <skos:prefLabel xml:lang="en">LAW AND LEGAL STUDIES</skos:prefLabel>
        <skos:notation xml:lang="en">48</skos:notation>
        <skos:inScheme rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
        <skos:topConceptOf rdf:resource="https://linked.data.gov.au/def/anzsrc-for/2020"/>
        <skos:definition xml:lang="en">This division covers law and legal studies.</skos:definition>
        <skos:scopeNote xml:lang="en">a) Criminology, including policing and correctional theory, is included in Group 4402 Criminology.
b) Legal ethics and human rights and justice issues are included in Group 5001 Applied ethics.
c) History and philosophy of law and justice is included in Group 5002 History and philosophy of specific fields.
